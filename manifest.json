{
  "manifest_version": 2,
  "name": "WebRTC Stream Recorder",
  "version": "1.0",
  "description": "Record WebRTC video and audio streams in real time from any web page, without re-encoding.",

  "browser_specific_settings": {
    "gecko": {
      "id": "webrtc-recorder@votrenom.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "permissions": ["activeTab", "tabs", "downloads"],

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "WebRTC Stream Recorder",
    "default_icon": {
      "48":  "icons/icon-48.png",
      "96":  "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  }
}